DATABASE_URL=postgresql://cloudgeniee:changeme@localhost:5432/cloudgeniee
REDIS_URL=redis://localhost:6379

# S3 + SQS → shaheen AWS account
AWS_PROFILE=shaheen
AWS_REGION=us-east-1

# Bedrock → kickid AWS account (needs Bedrock quota)
BEDROCK_AWS_PROFILE=kickid
BEDROCK_REGION=us-east-1

S3_BUCKET_NAME=your-bucket-name
SQS_INGESTION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT_ID/cloudgeniee-ingestion.fifo

# LLM options: amazon.nova-lite-v1:0 | amazon.nova-pro-v1:0 | qwen.qwen3-32b-v1:0
#              mistral.mistral-large-3-675b-instruct | deepseek.v3.2
BEDROCK_LLM_MODEL=mistral.mistral-large-3-675b-instruct
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Voice — Deepgram. STT (Nova-3) transcribes what the user says; TTS (Aura) is the
# bot's spoken voice. Only text is stored. Get a key at deepgram.com ($200 free credit).
# Aura voices: aura-asteria-en, aura-luna-en, aura-stella-en, aura-athena-en,
#              aura-orion-en, aura-arcas-en, aura-perseus-en, aura-zeus-en.
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_STT_MODEL=nova-3

# ─── Realtime voice (self-hosted LiveKit + voice agent worker) ─────────────────
# Public URL browsers join (TLS via nginx); internal URL the agent worker uses on the same host.
LIVEKIT_URL=wss://voice.cloudgeniee.com
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880
# Must match the `keys:` pair in /etc/livekit/livekit.yaml on the server.
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=cloudgeniee-voice

# SMTP — use a Gmail app password (not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=CloudGeniee <your-email@gmail.com>
DASHBOARD_URL=http://localhost:3000

API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
# Generate with: openssl rand -hex 32
API_SECRET=change-this-to-a-long-random-string
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Google Sign-In — OAuth client ID + secret from Google Cloud Console.
# Uses the Authorization Code flow: the dashboard opens its own centered popup,
# Google redirects to GOOGLE_CLIENT_ID's registered redirect URI
# ({API_PUBLIC_URL}/api/auth/google/callback), and this server exchanges the
# code for the user's identity using the secret. Register that exact redirect
# URI in the OAuth client's "Authorized redirect URIs" in Google Cloud Console.
# GOOGLE_CLIENT_ID must also match NEXT_PUBLIC_GOOGLE_CLIENT_ID in the dashboard.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
